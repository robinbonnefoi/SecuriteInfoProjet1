<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="web,accesslog,">

  <rule id="31106" level="15" overwrite="yes">
    <if_sid>31103, 31104, 31105</if_sid>
    <id>^200</id>
    <description>A web attack returned code 200 (success).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,pci_dss_6.5,pci_dss_11.4,gdpr_IV_35.7.d,nist_800_53_SA.11,nist_800_53_SI.4,tsc_CC6.6,tsc_CC7.1,tsc_CC8.1,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<group name="syslog,errors,">

  <rule id="2502" level="13" overwrite="yes">
    <match>more authentication failures;|REPEATED login failures</match>
    <description>syslog : Possible SSH Brute Force Detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.8,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<group name="suricata,">
  
  <rule id="100013" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000004$</field>
    <description>Suricata: High severity alert - $(alert.signature)</description>
    <group>web,attack,</group>
  </rule>

  <rule id="100011" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000002$</field>
    <description>Suricata: High severity alert - $(alert.signature)</description>
    <group>recon,</group>
  </rule>

  <rule id="100010" level="11">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000001$</field>
    <description>Suricata: High severity alert - $(alert.signature)</description>
    <group>attempted_dos,</group>
  </rule>
</group>
