alert tcp any any -> $HOME_NET any (msg:"Possible SYN Flood Detected"; flags:S; threshold:type both, track by_dst, count 1200, seconds 5; classtype:attempted-dos; priority:1; sid:1000001; rev:2;)
alert tcp any any -> $HOME_NET !80 (msg:"Possible Port Scan Detected"; flags:S; threshold:type both, track by_src, count 50, seconds 5; classtype:attempted-recon; priority:1; sid:1000002; rev:2;)
